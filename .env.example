# ── Sitio ────────────────────────────────────────────────
# URL pública definitiva, sin diagonal final. Se usa para canonicals, sitemap y JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Contacto (déjalos vacíos hasta confirmarlos; el sitio oculta lo que no esté definido) ──
# WhatsApp en formato internacional, solo dígitos (ej. 52 + 10 dígitos).
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
# Redes oficiales separadas por coma (URLs completas).
NEXT_PUBLIC_SOCIAL_URLS=

# ── Datos comerciales ────────────────────────────────────
# Ruta pública del logotipo oficial, ej. /brand/logo.svg. Vacío = wordmark temporal.
NEXT_PUBLIC_LOGO_PATH=
# Solo "true" cuando los datos del negocio estén verificados: activa JSON-LD LocalBusiness.
NEXT_PUBLIC_BUSINESS_VERIFIED=false
# Publicar dirección del taller solo con autorización expresa.
NEXT_PUBLIC_PUBLISH_ADDRESS=false
NEXT_PUBLIC_STREET_ADDRESS=
NEXT_PUBLIC_POSTAL_CODE=
# Horarios de cita confirmados (texto libre, ej. "Lunes a viernes, con cita previa").
NEXT_PUBLIC_HOURS_TEXT=

# Etapas siguientes (formulario, analítica) agregarán sus variables aquí.
